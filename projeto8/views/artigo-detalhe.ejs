<%- include("partials/header") %>
    <section class="header-pagina-interna">
        <div class="container">
            <h2><%= artigo.titulo %></h2>
        </div>
    </section>
    <section class="scroll-mt py-5">
        <div class="container py-5">
            <div class="row">
                <div class="col-lg-6">
                    <div class="capa shadow"
                        style="background-image: url('/assets/img/<%= artigo.imagem %>');"></div>
                </div>
                <div class="col-lg-6 ps-lg-5 mt-3 mt-lg-0">
                    <p class="fs-5 lh-3 text-dark">
                        <%= artigo.conteudo %>
                    </p>
                </div>
            </div>
        </div>
    </section>
    <%- include("partials/footer") %>